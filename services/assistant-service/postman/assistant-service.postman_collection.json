{
  "info": {
    "_postman_id": "4f1e2a7b-6c3d-4e8f-9a1b-assistant-service-collection",
    "name": "assistant-service",
    "description": "assistant-service (:8086) has one endpoint: POST /api/assistant/chat, which streams the answer as server-sent events (conversation, token..., then done or error). Two folders: direct-to-service request checks (the service trusts X-User-Id, which api-gateway normally sets), and the same through api-gateway (:8080) with a real login. The streamed requests need search-service and recommendation-service running and an OpenAI key; without a key they still pass, ending in an error event (see the service README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086",
      "description": "assistant-service, called directly"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "description": "api-gateway, in front of every service"
    },
    {
      "key": "userId",
      "value": "postman-user",
      "description": "X-User-Id for direct calls"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "postman-password-123"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Direct to assistant-service (:8086)",
      "item": [
        {
          "name": "1. Chat - streams conversation, token and done events",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Stream starts with a conversation event', function () { pm.expect(pm.response.text()).to.include('event:conversation'); });",
                  "pm.test('Stream ends with done, or error when no OpenAI key is set', function () { pm.expect(pm.response.text()).to.match(/event:(done|error)/); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"A quiet science fiction film about first contact\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assistant/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "chat"
              ]
            }
          }
        },
        {
          "name": "2. Chat without X-User-Id returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"Hi\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assistant/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "chat"
              ]
            }
          }
        },
        {
          "name": "3. Chat with a blank message returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Names the field', function () { pm.expect(pm.response.json().errorMessage).to.include('message'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \" \"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assistant/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "chat"
              ]
            }
          }
        },
        {
          "name": "4. Chat with a malformed conversationId returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"Hi\", \"conversationId\": \"not valid!\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assistant/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "chat"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Through api-gateway (:8080) - auth enforced",
      "item": [
        {
          "name": "1. Chat without a token returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"Hi\"}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/assistant/chat",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "chat"
              ]
            }
          }
        },
        {
          "name": "2. Register (public route)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('email', 'postman-assistant-' + Date.now() + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Postman Assistant Tester\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          }
        },
        {
          "name": "3. Login (public route)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          }
        },
        {
          "name": "4. Chat with a valid token streams an answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Stream ends with done, or error when no OpenAI key is set', function () { pm.expect(pm.response.text()).to.match(/event:(done|error)/); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"What should I watch tonight?\"}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/assistant/chat",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "chat"
              ]
            }
          }
        }
      ]
    }
  ]
}