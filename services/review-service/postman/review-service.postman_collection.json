{
  "info": {
    "_postman_id": "3f6b1e9a-7c2d-4a3e-9d1b-review-service-collection",
    "name": "review-service",
    "description": "Review/rating CRUD for review-service (:8083), plus a folder that goes through api-gateway (:8080) to exercise JWT enforcement (see ADR-0007). Run top-to-bottom within a folder — later requests reuse variables the earlier ones set. userId/movieId are opaque strings here (see CreateReviewRequest's Javadoc) — no catalog-service/user-service id needs to actually exist for the direct-to-service folder; the gateway folder registers a real user via user-service so it has a token to send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083", "description": "review-service, called directly" },
    { "key": "gatewayUrl", "value": "http://localhost:8080", "description": "api-gateway, in front of every service" },
    { "key": "movieId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "password123" },
    { "key": "token", "value": "" },
    { "key": "gatewayReviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Direct to review-service (:8083)",
      "description": "Hits review-service on its own port. No auth is enforced here — that only happens at api-gateway (see the other folder) — so these exercise the service's own CRUD, validation, and outbox-write logic in isolation.",
      "item": [
        {
          "name": "1. Create review",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// movie_id is VARCHAR(24) in Postgres (sized for a Mongo ObjectId hex string, see",
                  "// V1__create_reviews_and_outbox.sql) - a longer value trips DataIntegrityViolationException,",
                  "// which GlobalExceptionHandler maps to a 409 ('already exists'), not a validation error.",
                  "const hex = (Date.now().toString(16) + Math.random().toString(16).slice(2)).slice(0, 24);",
                  "pm.collectionVariables.set('movieId', hex);",
                  "pm.collectionVariables.set('userId', 'postman-user-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('reviewId', String(json.id));",
                  "pm.test('response echoes the request', function () {",
                  "    pm.expect(json.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "    pm.expect(json.movieId).to.eql(pm.collectionVariables.get('movieId'));",
                  "    pm.expect(json.rating).to.eql(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"movieId\": \"{{movieId}}\",\n  \"rating\": 5,\n  \"reviewText\": \"Postman test review - great movie.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          }
        },
        {
          "name": "2. Create review - validation errors",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "const json = pm.response.json();",
                  "pm.test('field errors present for movieId and rating', function () {",
                  "    pm.expect(json).to.have.property('movieId');",
                  "    pm.expect(json).to.have.property('rating');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"rating\": 9\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          }
        },
