    {
      "name": "Through api-gateway (:8080) - auth enforced",
      "description": "Same endpoints, but routed through api-gateway, which is where JWT validation actually happens (see ADR-0007). Requires api-gateway and user-service running, not just review-service. Registers/logs in a real user via user-service's public routes to get a token, since review-service itself doesn't tie a review's userId field to the caller's authenticated identity (any opaque userId string is accepted in the body either way).",
      "item": [
        {
          "name": "1. List reviews without a token returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/reviews?movieId=any-movie",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "reviews"],
              "query": [{ "key": "movieId", "value": "any-movie" }]
            }
          }
        },
        {
          "name": "2. Register (public route)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('email', 'postman-review-' + Date.now() + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Postman Review Tester\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/register",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "users", "register"]
            }
          }
        },
        {
          "name": "3. Login (public route)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "users", "login"]
            }
          }
        },
        {
          "name": "4. Create review with a valid token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// movie_id is VARCHAR(24) in Postgres - keep this hex and short (see the direct-to-service folder's create-review prerequest script for the full explanation).",
                  "const hex = (Date.now().toString(16) + Math.random().toString(16).slice(2)).slice(0, 24);",
                  "pm.collectionVariables.set('movieId', hex);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('gatewayReviewId', String(pm.response.json().id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"gateway-postman-user\",\n  \"movieId\": \"{{movieId}}\",\n  \"rating\": 4,\n  \"reviewText\": \"Created through the gateway.\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/reviews",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "reviews"]
            }
          }
        },
        {
          "name": "5. Get the review with a valid token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/reviews/{{gatewayReviewId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "reviews", "{{gatewayReviewId}}"]
            }
          }
        },
        {
          "name": "6. Delete the review with a valid token (cleanup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/reviews/{{gatewayReviewId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "reviews", "{{gatewayReviewId}}"]
            }
          }
        }
      ]
    }
  ]
}
