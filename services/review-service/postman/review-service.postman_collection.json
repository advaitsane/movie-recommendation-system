                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('text updated, rating unchanged', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.reviewText).to.eql('Edited via Postman - still great.');",
                  "    pm.expect(json.rating).to.eql(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewText\": \"Edited via Postman - still great.\"\n}"
            },
            "url": {
